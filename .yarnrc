# Keep one canonical dependency tree in the repository root.
# .work is reserved for mutable caches/build/log/state, not node_modules.
--modules-folder "node_modules"
--cache-folder ".work/cache/yarn"

# Waddle is Windows-only. discord-rpc declares register-scheme as an optional
# non-Electron fallback; inside Electron it uses app.setAsDefaultProtocolClient.
# Skip optional native fallbacks so clean installs do not invoke node-gyp/VS.
--ignore-optional true

# Tool versions are pinned and validated explicitly by the Waddle bootstrap.
# Avoid Yarn 1 warning on packages that advertise a custom "electron" engine.
--ignore-engines true
