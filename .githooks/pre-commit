#!/bin/sh

# Before any manual commit (including GitHub Desktop), verify that the tracked
# GitHub branch is not newer. Local edits are allowed when HEAD is current; if
# remote advanced, the commit is blocked so stale source cannot be committed as
# thousands of false NEW/MODIFIED files.
case "${GITHUB_ACTIONS:-}" in
  true|1) exit 0 ;;
esac
case "${WADDLE_DISABLE_SOURCE_SYNC:-}" in
  1) exit 0 ;;
esac

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
script="$repo/.github/scripts/waddle-source-sync.ps1"
[ -f "$script" ] || exit 0

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script" -Trigger manual -RequireRemote
code=$?
if [ "$code" -ne 0 ]; then
  echo "WADDLE_GIT_GUARD=BLOCKED hook=pre-commit exit=$code local_files_preserved=true" >&2
  echo "Run Waddle-Sync.cmd, then review the real remaining changes before committing." >&2
  exit "$code"
fi

exit 0
